# Conexión PostgreSQL clínica (Neon en la configuración actual)
PG_CONNECTION_STRING=postgresql://usuario:password@host:5432/database?sslmode=require

# JWT
JWT_SECRET_KEY=CAMBIAR_POR_UN_SECRETO_SEGURO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# FHIR / rest-hook R21
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir
FHIR_HOOK_URL=http://api:8000/fhir-hook
FHIR_HOOK_TOKEN=CAMBIAR_POR_TOKEN_SEGURO

# Servicio ML / seudonimización
ML_URL=http://ml:8001
ML_SERVICE_TOKEN=CAMBIAR_POR_TOKEN_SEGURO
SEUDONIMO_SECRETO=CAMBIAR_POR_SECRETO_SEGURO
ALERTA_ESCALAR_MINUTOS=5

# Mongo (Docker Compose la sobrescribe con el servicio mongodb)
MONGO_CONNECTION_STRING=mongodb://mongodb:27017/triaje

# Asistente RAG (rag/ y POST /rag/preguntar)
# Sin GROQ_API_KEY, o con el cupo de Groq agotado, el asistente responde en modo extractivo.
GROQ_API_KEY=CAMBIAR_POR_LLAVE_DE_GROQ
GROQ_MODEL=llama-3.3-70b-versatile
RAG_METODO=dense
RAG_TOP_K=5
RAG_MAX_CONTEXTO=8
RAG_UMBRAL_COS=0.35

# R31: identidad institucional (OAuth2 client credentials entre sistemas)
# Debe ser DISTINTA de JWT_SECRET_KEY y de 32 o más caracteres.
# Generar una propia con: python -c "import secrets; print(secrets.token_urlsafe(48))"
INSTITUCION_JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
INSTITUCION_TOKEN_MINUTOS=10

# R27: cifrado AES-256-GCM de teléfono y dirección.
# Llave de 32 bytes en base64. TODO el equipo y el servidor deben usar la MISMA llave.
# Nunca se sube al repositorio. Generar una con (desde back/):
#   python -c "from core.cifrado import generar_llave; print(generar_llave())"
CIFRADO_LLAVE_K1=CAMBIAR_POR_LLAVE_BASE64_DE_32_BYTES


# R30-R32: interoperabilidad con la institución socio (contrato en docs/CONTRATO_R30.md).
# Ids FHIR seudónimos de lo que enviamos: 32 o más caracteres; el MISMO en todo el equipo.
R30_IDENTIFICADOR_SECRETO=CAMBIAR_POR_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
# Quién es el socio: su client_id en NUESTRA base (lo crea Sarah con
# scripts/gestionar_cliente_institucional.py). Con él se guarda el consentimiento
# del paciente (R32) y solo esa institución puede responder lo que le enviamos.
# Para la autoprueba local se usa socio-demo.
R30_SOCIO_ID=socio-demo
R30_SOCIO_NOMBRE=Institución de demostración
R30_INSTITUCION_NOMBRE=Salud Digital · Triaje
R30_CONSENTIMIENTO_DIAS=365
# Recibir Bundles sin Consent: dejar en true (R32).
R30_EXIGIR_CONSENT=true
# Endpoints DEL SOCIO (HTTPS; http solo para localhost/api en la autoprueba).
#   Autoprueba local (la API se remite a sí misma dentro de Docker):
#   R30_SOCIO_URL=http://api:8000/fhir/remisiones-r30/recibir
#   R30_SOCIO_RESPUESTA_URL=http://api:8000/fhir/remisiones-r30/respuesta
#   R30_SOCIO_TOKEN_URL=http://api:8000/oauth/token
R30_SOCIO_URL=
R30_SOCIO_RESPUESTA_URL=
# Nuestras credenciales EN EL SISTEMA DEL SOCIO (las da el socio). Una de dos:
#   a) client credentials:
R30_SOCIO_TOKEN_URL=
R30_SOCIO_CLIENT_ID=
R30_SOCIO_CLIENT_SECRET=
#   b) API key fija (si el socio usa ese esquema):
R30_SOCIO_API_KEY=
R30_SOCIO_API_KEY_HEADER=X-API-Key
# R31 entrada con clave fija (socios que no piden token). Vacio = desactivado.
# Va el client_id creado con scripts/gestionar_cliente_institucional.py; la clave que el socio envia en
# X-System-Key, X-API-Key o Authorization: Bearer es el client_secret de ese id.
R30_ENTRADA_CLIENT_ID=
